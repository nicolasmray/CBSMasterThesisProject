         Each box shows the system prompt snippet and human message
         pattern for that LLM call point.
    ═══════════════════════════════════════════════════════════ -->

    <!-- ① Orchestrator -->
    <mxCell id="ann_1" value="&lt;b&gt;① Orchestrator — intent classification&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;You are the Orchestrator of a multi-agent BI assistant. Classify intent: rag | sql | chart | hybrid. Return JSON {intent, plan}.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; {user_query}" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="50" width="490" height="95" as="geometry" />
    </mxCell>

    <!-- ② RAG Reranker -->
    <mxCell id="ann_2" value="&lt;b&gt;② RAG Agent — LLM reranker (chunk relevance filter)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;You are a relevance filter. Select ONLY genuinely relevant chunks. Return a JSON array of indices: [0, 2, 5]. Return ONLY the array.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Question: {user_query}\n\nChunks:\n[Chunk N] (score: X, source: Y)\n{content}...&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="158" width="490" height="105" as="geometry" />
    </mxCell>

    <!-- ③ SQL Agent — initial generation -->
    <mxCell id="ann_3" value="&lt;b&gt;③ SQL Agent — initial SQL generation&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;You are a SQL specialist for PostgreSQL. Write a single correct SQL query using ONLY columns listed in the schema. Return ONLY the raw SQL.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Schema: {schema}\nPlan: {plan}\n[date_hint]\n[RAG context if hybrid]\nQuestion: {user_query}&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="276" width="490" height="105" as="geometry" />
    </mxCell>

    <!-- ④ SQL Agent — retry -->
    <mxCell id="ann_4" value="&lt;b&gt;④ SQL Agent — retry SQL (on error, up to 3 times)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; [same SQL system prompt as ③]&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Previous SQL failed: {error_info}. Extra context from KB: {extra_context}. Schema: {schema}. Original question: {user_query}. Write a corrected PostgreSQL SQL query.&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="394" width="490" height="105" as="geometry" />
    </mxCell>

    <!-- ⑤ Chart Agent -->
    <mxCell id="ann_5" value="&lt;b&gt;⑤ Chart Agent — chart type &amp;amp; axis selection&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;You are a Chart specialist for business analytics. Return 1–4 chart configs ranked by fit as a JSON array. Available types: bar, line, pie, scatter, heatmap, waterfall, treemap...&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Data sample (first 5 rows): {json}\nAll columns: {cols}\nUser question: {user_query}&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="512" width="490" height="110" as="geometry" />
    </mxCell>

    <!-- ⑥ Response Agent — interpretation (≤12 rows) -->
    <mxCell id="ann_6" value="&lt;b&gt;⑥ Response Agent — business interpretation (result ≤ 12 rows)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;BI assistant providing executive-level insight. Add business VALUE — do NOT restate numbers. Write 2–4 sentences identifying the most notable trend, pattern, or outlier.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Question: {user_query}\nThe query returned N row(s).\nColumns: {col_names}. [+ RAG context &amp;amp; chart note if present]&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="635" width="490" height="115" as="geometry" />
    </mxCell>

    <!-- ⑦ Response Agent — grounded insight (>12 rows) -->
    <mxCell id="ann_7" value="&lt;b&gt;⑦ Response Agent — grounded insight (result &amp;gt; 12 rows)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;BI assistant. Every number you write MUST appear verbatim in the Computed Facts provided. Write 1–3 sentences of insight. Do NOT round or approximate.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Question: {user_query}\nComputed Facts (use ONLY these numbers): {key_facts}\n[+ RAG context &amp;amp; chart note if present]&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="763" width="490" height="115" as="geometry" />
    </mxCell>

    <!-- ⑧ Response Agent — RAG-only answer -->
    <mxCell id="ann_8" value="&lt;b&gt;⑧ Response Agent — RAG-only answer (no SQL result)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sys:&lt;/i&gt; &quot;BI assistant. Answer the user&apos;s question using ONLY the provided document context. Do NOT invent numbers or facts. If context is insufficient, say so clearly.&quot;&lt;br&gt;&lt;i&gt;Human:&lt;/i&gt; &quot;Question: {user_query}\n\nContext:\n{chunk_text}&quot;" style="shape=mxgraph.flowchart.annotation;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#9673A6;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1">
      <mxGeometry x="1840" y="891" width="490" height="105" as="geometry" />
    </mxCell>

